# BigQuery MCP Server Configuration

# Required: GCP project ID
GOOGLE_PROJECT_ID="my-gcp-project"

# Optional: BigQuery location/region (default: US)
GOOGLE_LOCATION="US"

# Optional: Path to service account key file (uses ADC if not set)
# GOOGLE_KEY_FILE="path/to/service-account.json"

# Optional: Comma-separated dataset whitelist (empty = all datasets)
# DATASETS_FILTER="analytics,sales"

# Optional: Path to YAML config file (default: config.yaml in project root)
# CONFIG_FILE_PATH="config.yaml"

# Table access mode: yaml_only | auto_discovery | hybrid (default: hybrid)
TABLE_ACCESS_MODE="hybrid"

# Security toggles (all default to true)
ALLOW_WRITE_TOOLS=false
ENABLE_SECURITY_VALIDATOR=true
ENABLE_YAML_VALIDATOR=true
ENABLE_QUERY_REWRITER=true
ENABLE_RATE_LIMITER=true
ENABLE_PII_MASKING=true
ENABLE_AUDIT_LOGGING=true

# Query limits
MAX_QUERY_LENGTH=10000
MAX_ROWS=1000
DEFAULT_LIMIT=100
MAX_BYTES_BILLED=10737418240  # 10 GiB

# Rate limiting
RATE_LIMIT_MAX_CALLS=100
RATE_LIMIT_WINDOW_SECONDS=3600

# Optional: Maximum bytes billed per query (default: 160 GiB)
# MAX_BYTES_BILLED=171798691840

# Optional: Path to YAML config file (default: config.yaml in project root)
# CONFIG_FILE_PATH="config.yaml"
