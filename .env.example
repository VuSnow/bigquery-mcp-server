# BigQuery MCP Server
# All configuration lives in config.yaml. Only these env vars are needed:

# Path to YAML config file (default: config.yaml in project root)
# CONFIG_FILE_PATH="config.yaml"

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Maximum bytes billed per query (default: 160 GiB)
# MAX_BYTES_BILLED=171798691840

# Optional: Path to YAML config file (default: config.yaml in project root)
# CONFIG_FILE_PATH="config.yaml"
